      ]
    }
  },
  "eventos": {
    "E0001": {
      "id": "E0001",
      "nome": "Construção do complexo Auschwitz",
      "data": "1940-05-20",
      "local": "Oświęcim",
      "resumo": "Polônia",
      "fontes": [
        "SS estabelece Auschwitz I",
        "Auschwitz II-Birkenau expande-se a partir de outubro de 1941 como centro de extermínio",
        "Auschwitz III-Monowitz como campo de trabalho."
      ]
    },
    "E0002": {
      "id": "E0002",
      "nome": "Primeiro transporte eslovaco a Auschwitz",
      "data": "1942-04-25",
      "local": "Oświęcim",
      "resumo": "Polônia",
      "fontes": [
        "Transportes da Eslováquia ocupada chegam a Birkenau entre 1942 e 1944",
        "entre eles jovens judeus recrutados ao Sonderkommando (caso de Filip Müller)."
      ]
    },
    "E0003": {
      "id": "E0003",
      "nome": "Chegada de judeus húngaros a Birkenau",
      "data": "1944-05-15",
      "local": "Birkenau",
      "resumo": "Polônia",
      "fontes": [
        "Maior e mais rápida deportação do Holocausto: cerca de 424 mil judeus húngaros em menos de dois meses",
        "documentada pelas fotos do Auschwitz Album."
      ]
    },
    "E0004": {
      "id": "E0004",
      "nome": "Levantamento do Sonderkommando",
      "data": "1944-10-07",
      "local": "Birkenau",
      "resumo": "Polônia",
      "fontes": [
        "Sonderkommandos do Crematório IV destroem o forno e revoltam-se",
        "Zalmen Gradowski e outros morrem no confronto",
        "três mulheres da Werkguppe smuggam pólvora para a explosão."
      ]
    },
    "E0005": {
      "id": "E0005",
      "nome": "Levantamento do Gueto de Varsóvia",
      "data": "1943-04-19",
      "local": "Warszawa",
      "resumo": "Polônia",
      "fontes": [
        "Insurreição armada dos judeus do gueto contra a deportação final",
        "reprimida pelo SS-Sturmbannführer Jürgen Stroop",
        "documentada no Relatório Stroop."
      ]
    },
    "E0006": {
      "id": "E0006",
      "nome": "Noite dos Cristais",
